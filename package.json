{
  "name": "pickle-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3210",
    "build": "next build && node scripts/prepare-desktop.mjs",
    "start": "next start -H 127.0.0.1 -p 3210",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "desktop": "electron .",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "build": {
    "appId": "local.pickle.clone",
    "productName": "Oh My Picklebot",
    "asar": true,
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "description": "A local, cross-platform Pickle reconstruction built with Next.js and TypeScript."
}
